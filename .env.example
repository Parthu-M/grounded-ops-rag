# Project paths
GROUNDED_OPS_HOME=.
CHROMA_PATH=.runtime/chroma
QUERY_LOG_PATH=.runtime/logs/rag_queries.jsonl
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=.runtime/uploads
MAX_UPLOAD_MB=15
MAX_UPLOAD_FILES=10

# RAG defaults
CHROMA_COLLECTION=knowledge_base
CHUNK_SIZE_WORDS=120
CHUNK_OVERLAP_WORDS=25
EMBEDDING_MODEL=local/hash-hybrid-ngram-v1
EMBEDDING_DIM=768
RETRIEVAL_TOP_K=3
MIN_RELEVANCE_SCORE=0.12

# "extractive" is deterministic and key-free. Use "openai" for generated answers.
GENERATOR_PROVIDER=extractive
GENERATOR_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Judge. "heuristic" is only the transparent CI baseline; use "openai" for an LLM run.
JUDGE_PROVIDER=heuristic
JUDGE_MODEL=gpt-5.1
JUDGE_FAMILY=openai
GENERATOR_A_FAMILY=demo-rules-a
GENERATOR_B_FAMILY=demo-rules-b
ALLOW_SAME_FAMILY_JUDGE=false
JUDGE_REPEATS=1
JUDGE_LOG_PATH=.runtime/logs/judge_calls.jsonl
